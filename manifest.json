{
  "id": "wetter",
  "name": "Wetter",
  "version": "1.3.0",
  "description": "Current weather and a colored week overview for any coordinates — condition, temperature, today's low and high, and one green, yellow or red tile per day. Built for the Note, adapts to the Flagship. Forecasts from Open-Meteo, no API key needed.",
  "author": "Oliver Rummeyer",
  "repository": "https://github.com/rummeyer/fiestaboard-plugin--wetter",
  "documentation": "README.md",
  "icon": "cloud-sun",
  "category": "weather",
  "fiestaboard_version": ">=8.25.0",
  "min_refresh_seconds": 300,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enabled",
        "default": false
      },
      "coordinates": {
        "type": "string",
        "title": "Coordinates",
        "description": "Latitude and longitude, e.g. 52.52, 13.405. Right-click a spot in Google Maps or OpenStreetMap and copy the numbers it shows.",
        "default": ""
      },
      "location_name": {
        "type": "string",
        "title": "Location name",
        "description": "Optional. Only used by the {{wetter.location}} variable — the built-in layout has no room for it on a Note.",
        "default": ""
      },
      "language": {
        "type": "string",
        "title": "Language",
        "description": "Language of the condition words and weekday names.",
        "enum": [
          "de",
          "en"
        ],
        "enumNames": [
          "Deutsch",
          "English"
        ],
        "default": "de"
      },
      "units": {
        "type": "string",
        "title": "Units",
        "enum": [
          "metric",
          "imperial"
        ],
        "enumNames": [
          "Metric (°C, mm, km/h)",
          "Imperial (°F, in, mph)"
        ],
        "default": "metric"
      },
      "week_start": {
        "type": "string",
        "title": "Week overview",
        "description": "Monday shows the calendar week, Monday to Sunday — days already past are filled in from what the weather actually was. The other two show the next seven days. Today's low and high are shown either way.",
        "enum": [
          "monday",
          "today",
          "tomorrow"
        ],
        "enumNames": [
          "Calendar week (Mon–Sun)",
          "Next 7 days from today",
          "Next 7 days from tomorrow"
        ],
        "default": "monday"
      },
      "rain_threshold": {
        "type": "number",
        "title": "Rain threshold (mm)",
        "description": "A wet day with less precipitation than this is rated yellow, not red. Open-Meteo reports a day's most severe weather, so a single drizzly hour would otherwise make the whole day red.",
        "default": 1.0,
        "minimum": 0
      },
      "color_good": {
        "type": "string",
        "title": "Color: dry and sunny",
        "enum": [
          "green",
          "blue",
          "yellow",
          "orange",
          "red",
          "violet",
          "contrast",
          "background"
        ],
        "enumNames": [
          "Green",
          "Blue",
          "Yellow",
          "Orange",
          "Red",
          "Violet",
          "Contrast",
          "Background"
        ],
        "default": "green"
      },
      "color_mixed": {
        "type": "string",
        "title": "Color: cloudy or foggy",
        "enum": [
          "contrast",
          "background",
          "yellow",
          "orange",
          "green",
          "blue",
          "red",
          "violet"
        ],
        "enumNames": [
          "Contrast",
          "Background",
          "Yellow",
          "Orange",
          "Green",
          "Blue",
          "Red",
          "Violet"
        ],
        "default": "contrast"
      },
      "color_bad": {
        "type": "string",
        "title": "Color: rain, snow or thunder",
        "enum": [
          "red",
          "orange",
          "violet",
          "blue",
          "yellow",
          "green",
          "contrast",
          "background"
        ],
        "enumNames": [
          "Red",
          "Orange",
          "Violet",
          "Blue",
          "Yellow",
          "Green",
          "Contrast",
          "Background"
        ],
        "default": "red"
      },
      "degree_sign": {
        "type": "string",
        "title": "Degree sign",
        "description": "Board character 62 is a degree sign on a Flagship. Some Notes carry a heart or a blank flap at that position instead; choose Auto to leave the sign off on note-shaped boards.",
        "enum": [
          "on",
          "auto",
          "off"
        ],
        "enumNames": [
          "Always",
          "Auto (skip on Note)",
          "Never"
        ],
        "default": "on"
      },
      "umlauts": {
        "type": "string",
        "title": "Umlauts",
        "description": "The board has no umlaut tiles. Expand writes BEWOELKT, Strip writes BEWOLKT.",
        "enum": [
          "expand",
          "strip"
        ],
        "enumNames": [
          "Expand (BEWOELKT)",
          "Strip (BEWOLKT)"
        ],
        "default": "expand"
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval",
        "description": "Open-Meteo updates its current conditions every 15 minutes, so polling faster shows nothing new.",
        "default": 900,
        "minimum": 300,
        "maximum": 3600
      }
    }
  },
  "variables": {
    "groups": {
      "now": {
        "label": "Now"
      },
      "today": {
        "label": "Today"
      },
      "week": {
        "label": "Week"
      },
      "layout": {
        "label": "Board Lines"
      }
    },
    "simple": {
      "location": {
        "description": "The location name from the settings, empty when none is set",
        "type": "string",
        "max_length": 22,
        "group": "now",
        "example": "BERLIN"
      },
      "condition": {
        "description": "Current condition in words",
        "type": "string",
        "max_length": 10,
        "group": "now",
        "example": "BEWOELKT"
      },
      "condition_short": {
        "description": "Current condition in six tiles or fewer — what the first row falls back to on a Note",
        "type": "string",
        "max_length": 6,
        "group": "now",
        "example": "WOLKIG"
      },
      "temp": {
        "description": "Current temperature in whole degrees, no unit",
        "type": "string",
        "max_length": 4,
        "group": "now",
        "example": "12"
      },
      "feels_like": {
        "description": "Apparent temperature, no unit",
        "type": "string",
        "max_length": 4,
        "group": "now",
        "example": "10"
      },
      "temp_unit": {
        "description": "Unit suffix for temperatures, °C or °F (C or F when the degree sign is off)",
        "type": "string",
        "max_length": 2,
        "group": "now",
        "example": "°C"
      },
      "humidity": {
        "description": "Relative humidity in percent",
        "type": "string",
        "max_length": 3,
        "group": "now",
        "example": "71"
      },
      "wind": {
        "description": "Wind speed, km/h or mph",
        "type": "string",
        "max_length": 3,
        "group": "now",
        "example": "14"
      },
      "wind_unit": {
        "description": "KMH or MPH",
        "type": "string",
        "max_length": 3,
        "group": "now",
        "example": "KMH"
      },
      "color": {
        "description": "Color tile for today's rating — the same tile today has in the week overview",
        "type": "string",
        "max_length": 4,
        "group": "now",
        "example": "{69}"
      },
      "low": {
        "description": "Today's low, no unit",
        "type": "string",
        "max_length": 4,
        "group": "today",
        "example": "7"
      },
      "high": {
        "description": "Today's high, no unit",
        "type": "string",
        "max_length": 4,
        "group": "today",
        "example": "14"
      },
      "rain_chance": {
        "description": "Today's highest chance of precipitation in percent",
        "type": "string",
        "max_length": 3,
        "group": "today",
        "example": "20"
      },
      "rain": {
        "description": "Today's precipitation total, mm or inches",
        "type": "string",
        "max_length": 5,
        "group": "today",
        "example": "0.0"
      },
      "week_tiles": {
        "description": "Seven color tiles, one per day of the week overview",
        "type": "string",
        "max_length": 28,
        "group": "week",
        "example": "{63}{66}{69}{63}{66}{69}{66}"
      },
      "week": {
        "description": "Weekday initial plus color tile for each day — 14 tiles, fits a Note row",
        "type": "string",
        "max_length": 35,
        "group": "week",
        "example": "M{63}D{66}M{69}D{63}F{66}S{69}S{66}"
      },
      "block": {
        "description": "The whole laid-out board as one value, rows separated by newlines. Put this on the first template line to fill the board.",
        "type": "string",
        "max_length": 400,
        "group": "layout",
        "example": "WOLKIG 12°C 71%\\n{67} 7°C  {63} 14°C  \\nM{63}D{66}M{69}D{63}F{66}S{69}S{66} "
      },
      "line1": {
        "description": "Board row 1 of the layout: condition, temperature and humidity",
        "type": "string",
        "max_length": 60,
        "group": "layout",
        "example": "WOLKIG 12°C 71%"
      },
      "line2": {
        "description": "Board row 2 of the layout: today's low after a blue tile, the high after a red one",
        "type": "string",
        "max_length": 60,
        "group": "layout",
        "example": "{67} 7°C  {63} 14°C  "
      },
      "line3": {
        "description": "Board row 3: the week on a Note, rain and wind on a Flagship",
        "type": "string",
        "max_length": 100,
        "group": "layout",
        "example": "M{63}D{66}M{69}D{63}F{66}S{69}S{66} "
      },
      "line4": {
        "description": "Board row 4: weekday names on a Flagship, empty on a Note",
        "type": "string",
        "max_length": 60,
        "group": "layout",
        "example": " MO DI MI DO FR SA SO "
      },
      "line5": {
        "description": "Board row 5: the week as color bars on a Flagship, empty on a Note",
        "type": "string",
        "max_length": 100,
        "group": "layout",
        "example": " {63}{63} {66}{66} {69}{69} {63}{63} {66}{66} {69}{69} {66}{66} "
      },
      "line6": {
        "description": "Board row 6: each day's high on a Flagship, empty on a Note",
        "type": "string",
        "max_length": 60,
        "group": "layout",
        "example": " 10 13 12 10 15 14 16 "
      }
    },
    "arrays": {
      "days": {
        "label_field": "name",
        "item_fields": {
          "name": {
            "description": "Two-letter weekday",
            "type": "string",
            "max_length": 2,
            "group": "week",
            "example": "MO"
          },
          "date": {
            "description": "ISO date",
            "type": "string",
            "max_length": 10,
            "group": "week",
            "example": "2026-10-24"
          },
          "condition": {
            "description": "The day's weather in words",
            "type": "string",
            "max_length": 10,
            "group": "week",
            "example": "REGEN"
          },
          "high": {
            "description": "High, no unit",
            "type": "string",
            "max_length": 4,
            "group": "week",
            "example": "14"
          },
          "low": {
            "description": "Low, no unit",
            "type": "string",
            "max_length": 4,
            "group": "week",
            "example": "7"
          },
          "rain": {
            "description": "Precipitation total, mm or inches",
            "type": "string",
            "max_length": 5,
            "group": "week",
            "example": "5.2"
          },
          "rain_chance": {
            "description": "Highest chance of precipitation in percent",
            "type": "string",
            "max_length": 3,
            "group": "week",
            "example": "90"
          },
          "rating": {
            "description": "good, mixed or bad",
            "type": "string",
            "max_length": 5,
            "group": "week",
            "example": "bad"
          },
          "color": {
            "description": "The day's color tile",
            "type": "string",
            "max_length": 4,
            "group": "week",
            "example": "{63}"
          }
        }
      }
    }
  },
  "max_lengths": {
    "location": 22,
    "condition": 10,
    "condition_short": 6,
    "temp": 4,
    "feels_like": 4,
    "temp_unit": 2,
    "humidity": 3,
    "wind": 3,
    "wind_unit": 3,
    "color": 4,
    "low": 4,
    "high": 4,
    "rain_chance": 3,
    "rain": 5,
    "week_tiles": 28,
    "week": 35,
    "block": 400,
    "line1": 60,
    "line2": 60,
    "line3": 100,
    "line4": 60,
    "line5": 100,
    "line6": 60
  },
  "demo": {
    "name": "Wetter Demo",
    "device_type": "note",
    "template": [
      "{{wetter.block}}",
      "",
      ""
    ],
    "line_metadata": [
      {
        "alignment": "left",
        "wrap": false
      },
      {
        "alignment": "left",
        "wrap": false
      },
      {
        "alignment": "left",
        "wrap": false
      }
    ]
  },
  "teaser": "WOLKIG 12°C 71%",
  "previews": [
    {
      "device_type": "note",
      "rows": [
        "WOLKIG 12°C 71%",
        "{67} 7°C  {63} 14°C  ",
        "M{63}D{66}M{69}D{63}F{66}S{69}S{66} "
      ]
    },
    {
      "device_type": "flagship",
      "rows": [
        "BEWOELKT 12°C 71%     ",
        "{67} 7°C  {63} 14°C         ",
        "REGEN 20%   WIND 14KMH",
        " MO DI MI DO FR SA SO ",
        " {63}{63} {66}{66} {69}{69} {63}{63} {66}{66} {69}{69} {66}{66} ",
        " 10 13 12 10 15 14 16 "
      ]
    }
  ]
}
